# Optional. The app works without an API key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Optional. When set, everyone must enter this passcode to open the board.
PRAXIS_PASSCODE=

# Optional. The restaurant's time zone (defaults to this computer's).
PRAXIS_TIMEZONE=
# Optional. Where the SQLite database lives (defaults to data/timely.db).
PRAXIS_DB_FILE=
# Optional. A Python with OR-Tools installed (defaults to .venv-solver, then python3).
PRAXIS_PYTHON=

