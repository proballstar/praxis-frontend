{
  "name": "praxis",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3100",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "demo": "rm -f data/demo.db data/demo.db-wal data/demo.db-shm && PRAXIS_DB_FILE=data/demo.db next start --hostname 0.0.0.0 --port 3200",
    "setup:solver": "python3 -m venv .venv-solver && ./.venv-solver/bin/pip install --quiet ortools && ./.venv-solver/bin/python -c \"import ortools; print('OR-Tools', ortools.__version__, 'ready')\"",
    "bench:solver": "tsx scripts/bench-solver.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.86",
    "ai": "^7.0.164",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
